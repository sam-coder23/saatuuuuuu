{
  "name": "collaboration-wall-manager",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 3001",
    "build": "ng build --configuration=production --base-href /CollaborationWallManager/ --deploy-url /CollaborationWallManager/",
    "test": "karma start ./build/configuration/karma.config.js",
    "test:headless": "karma start ./build/configuration/karma-headless.config.js --browsers ChromeHeadless",
    "lint": "npm run lint:eslint & npm run lint:codelyzer & npm run lint:prettier",
    "lint:eslint": "eslint --ext .ts app/**/*.ts test/**/*.ts -o build/reports/eslint/eslint.log",
    "lint:codelyzer": "tslint -c ./eslint.codelyzer.json ./app/**/*.ts ./test/**/*.ts -o ./build/reports/eslint/codelyzer.log",
    "lint:prettier": "prettier --check ./app/**/*{.ts,.js,.html,.json,.scss} ./test/**/*{.ts,.js,.spec.ts}",
    "lint:prettier-fix": "prettier --write ./app/**/*{.ts,.js,.html,.json,.scss} ./test/**/*{.ts,.js,.spec.ts}",
    "sonar:publish": "node ./build/analysis/sonar/scanner.js"
  },
  "repository": {
    "type": "git",
    "url": "ssh://git@git.barco.com:7999/ocs/launchpad-cr.git"
  },
  "license": "ISC",
  "dependencies": {
    "@angular/animations": "~13.2.0",
    "@angular/cdk": "^13.2.1",
    "@angular/common": "~13.2.7",
    "@angular/compiler": "~13.2.0",
    "@angular/core": "~13.2.0",
    "@angular/forms": "~13.2.0",
    "@angular/material": "^13.2.1",
    "@angular/platform-browser": "~13.2.0",
    "@angular/platform-browser-dynamic": "~13.2.0",
    "@angular/router": "~13.2.0",
    "@ngx-translate/core": "^14.0.0",
    "@ngx-translate/http-loader": "^7.0.0",
    "core-js": "^3.1.2",
    "hammerjs": "^2.0.8",
    "reflect-metadata": "^0.1.10",
    "web-animations-js": "^2.2.2",
    "install": "^0.13.0",
    "node-sass": "^7.0.1",
    "rxjs": "~7.5.0",
    "sass-loader": "^12.4.0",
    "tslib": "^2.3.0",
    "webpack": "^5.69.1",
    "webpack-dev-server": "^4.7.4",
    "zone.js": "^0.11.4"
  },
  "devDependencies": {
    "@types/core-js": "^2.5.2",
    "@types/hammerjs": "^2.0.34",
    "@angular-devkit/build-angular": "~13.2.2",
    "@angular/cli": "~13.2.2",
    "@angular/compiler-cli": "~13.2.0",
    "@types/jasmine": "~3.10.0",
    "@types/node": "^12.11.1",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "codelyzer": "^6.0.2",
    "eslint": "^8.9.0",
    "jasmine-core": "~4.0.0",
    "karma": "~6.3.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.1.0",
    "karma-html-reporter": "^0.2.7",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "~1.7.0",
    "karma-scss-preprocessor": "^4.0.0",
    "karma-typescript": "^5.5.3",
    "karma-typescript-es6-transform": "^5.5.3",
    "node-sass": "^7.0.1",
    "prettier": "^2.5.1",
    "tslint": "^6.1.3",
    "typescript": "~4.5.2",
    "sonarqube-scanner": "^2.0.2"
  }
}
