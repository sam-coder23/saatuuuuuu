{
  "name": "collaboration-wall-manager",
  "version": "1.2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 3001",
    "build": "ng build --configuration=production --base-href /CollaborationWallManager/ --deploy-url /CollaborationWallManager/",
    "test": "karma start ./build/configuration/karma.config.js",
    "test:headless": "karma start ./build/configuration/karma-headless.config.js --browsers ChromeHeadless",
    "lint": "npm run lint:eslint & npm run lint:codelyzer & npm run lint:prettier",
    "lint:eslint": "eslint --ext .ts app/**/*.ts test/**/*.ts -o build/reports/eslint/eslint.log",
    "lint:codelyzer": "tslint -c ./eslint.codelyzer.json ./app/**/*.ts ./test/**/*.ts -o ./build/reports/eslint/codelyzer.log",
    "lint:prettier": "prettier --check ./app/**/*{.ts,.js,.html,.json,.scss} ./test/**/*{.ts,.js,.spec.ts}",
    "lint:prettier-fix": "prettier --write ./app/**/*{.ts,.js,.html,.json,.scss} ./test/**/*{.ts,.js,.spec.ts}",
    "sonar:publish": "node ./build/analysis/sonar/scanner.js"
  },
  "repository": {
    "type": "git",
    "url": "ssh://git@git.barco.com:7999/ocs/launchpad-cr.git"
  },
  "license": "ISC",
  "dependencies": {
    "@angular/animations": "^16.2.11",
    "@angular/cdk": "^16.0.0",
    "@angular/cli": "^16.2.8",
    "@angular/common": "^16.2.11",
    "@angular/compiler": "^16.2.11",
    "@angular/compiler-cli": "^16.2.11",
    "@angular/core": "^16.2.11",
    "@angular/forms": "^16.2.11",
    "@angular/material": "^16.2.14",
    "@angular/platform-browser": "^16.2.11",
    "@angular/platform-browser-dynamic": "^16.2.11",
    "@angular/router": "^16.2.11",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "core-js": "^3.31.0",
    "hammerjs": "^2.0.8",
    "install": "^0.13.0",
    "reflect-metadata": "^0.1.10",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.1",
    "web-animations-js": "^2.3.2",
    "zone.js": "^0.13.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~16.2.8",
    "@types/core-js": "^2.5.8",
    "@types/hammerjs": "^2.0.45",
    "@types/jasmine": "~5.1.4",
    "@types/node": "^20.14.11",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "codelyzer": "^6.0.2",
    "css-loader": "^6.8.1",
    "eslint": "^8.49.0",
    "eslint-plugin-jasmine": "^4.1.3",
    "eslint-webpack-plugin": "^3.1.1",
    "jasmine": "^4.0.0",
    "jasmine-core": "~4.0.0",
    "jasmine-spec-reporter": "^7.0.0",
    "karma": "~6.3.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.1.0",
    "karma-html-detailed-reporter": "^2.1.0",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "~1.7.0",
    "karma-scss-preprocessor": "^4.0.0",
    "karma-spec-reporter": "^0.0.32",
    "karma-typescript": "^5.5.3",
    "karma-typescript-es6-transform": "^5.5.3",
    "lite-server": "^2.5.4",
    "node-sass": "^8.0.0",
    "prettier": "^2.8.1",
    "sass-loader": "^13.3.2",
    "sonarqube-scanner": "^2.0.2",
    "style-loader": "^3.2.1",
    "tslint": "^6.1.3",
    "typescript": "~5.1.6",
    "webpack": "^5.69.1",
    "webpack-cli": "^4.9.2",
    "webpack-dev-server": "^4.7.4"
  }
}
