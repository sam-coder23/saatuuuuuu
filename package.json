{
  "name": "collaboration-wall-manager",
  "version": "2.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 3001",
    "build": "ng build --configuration=production --base-href /CollaborationWallManager/ --deploy-url /CollaborationWallManager/",
    "test": "karma start ./build/configuration/karma.config.js",
    "test:headless": "karma start ./build/configuration/karma-headless.config.js --browsers ChromeHeadless",
    "lint": "npm run lint:eslint & npm run lint:prettier",
    "lint:eslint": "eslint --ext .ts app/**/*.ts test/**/*.ts -o build/reports/eslint/eslint.log",
    "lint:prettier": "prettier --check ./app/**/*{.ts,.js,.html,.json,.scss} ./test/**/*{.ts,.js,.spec.ts}",
    "lint:prettier-fix": "prettier --write ./app/**/*{.ts,.js,.html,.json,.scss} ./test/**/*{.ts,.js,.spec.ts}",
    "sonar:publish": "node ./build/analysis/sonar/scanner.js"
  },
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com:barcoemu/tfn-launchpad-cr.git"
  },
  "license": "ISC",
  "dependencies": {
    "@angular/animations": "^18.2.3",
    "@angular/cdk": "^18.2.3",
    "@angular/cli": "^18.2.3",
    "@angular/common": "^18.2.3",
    "@angular/compiler": "^18.2.3",
    "@angular/compiler-cli": "^18.2.3",
    "@angular/core": "^18.2.3",
    "@angular/forms": "^18.2.3",
    "@angular/material": "^18.2.4",
    "@angular/platform-browser": "^18.2.3",
    "@angular/platform-browser-dynamic": "^18.2.3",
    "@angular/router": "^18.2.3",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "core-js": "^3.31.0",
    "hammerjs": "^2.0.8",
    "install": "^0.13.0",
    "reflect-metadata": "^0.1.10",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.1",
    "web-animations-js": "^2.3.2",
    "zone.js": "^0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~18.2.3",
    "@types/core-js": "^2.5.8",
    "@types/hammerjs": "^2.0.45",
    "@types/jasmine": "~5.1.4",
    "@types/node": "^20.14.11",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "css-loader": "^7.1.2",
    "eslint": "^8.49.0",
    "eslint-plugin-jasmine": "^4.1.3",
    "eslint-webpack-plugin": "^3.1.1",
    "eslint-import-resolver-typescript": "3.6.3",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-promise": "^7.1.0",
    "jasmine": "^4.0.0",
    "jasmine-core": "~4.0.0",
    "jasmine-spec-reporter": "^7.0.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "karma-junit-reporter": "^2.0.1",
    "karma-spec-reporter": "^0.0.36",
    "karma-typescript": "^5.5.4",
    "karma-typescript-es6-transform": "^5.5.4",
    "path-to-regexp": "^0.1.12",
    "prettier": "^2.8.1",
    "sass": "^1.78.0",
    "sass-loader": "^16.0.1",
    "sonarqube-scanner": "^2.0.2",
    "style-loader": "^4.0.0",
    "tslint": "^6.1.3",
    "typescript": "~5.4.5",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  }
}