{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "cli": {
    "analytics": false
  },
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "collaboration-wall-manager": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:application": {
          "strict": true
        },
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "build/build/dist/collaboration-wall-manager",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/icon_barco.png",
              "src/app/resources",
              "src/app/i18n",
              "src/WEB-INF/web.xml",
              "src/manifest.json",
              "src/version.properties"
            ],
            "styles": [
              "src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "2.5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "10kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "index": {
                "input": "src/dev.html",
                "output": "index.html"
              },
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "collaboration-wall-manager:build:production"
            },
            "development": {
              "proxyConfig": "src/proxy.conf.json",
              "buildTarget": "collaboration-wall-manager:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "collaboration-wall-manager:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "tests/unit-tests/base.ts",
            "polyfills": "src/deps.ts",
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "build/configuration/karma.config.js",
            "codeCoverage": true,
            "assets": [
              "src/icon_barco.png",
              "src/assets",
              "src/i18n"
            ],
            "styles": [],
            "scripts": []
          }
        }
      }
    }
  }
}
